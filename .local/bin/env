#!/bin/sh
# Move a directory to the front, removing any existing copies.
path_prepend() {
    path_remainder=${PATH-}:
    PATH=$1
    while [ -n "$path_remainder" ]; do
        path_entry=${path_remainder%%:*}
        path_remainder=${path_remainder#*:}
        [ "$path_entry" = "$1" ] || PATH="$PATH:$path_entry"
    done
    export PATH
    unset path_remainder path_entry
}

path_prepend "$HOME/.local/bin"

# Initialize Homebrew once, then keep its binaries ahead of other toolchains.
for brew_bin in "$HOME/.linuxbrew/bin/brew" /opt/homebrew/bin/brew \
    /home/linuxbrew/.linuxbrew/bin/brew /usr/local/bin/brew; do
    if [ -x "$brew_bin" ]; then
        if [ "${HOMEBREW_PREFIX:-}" != "${brew_bin%/bin/brew}" ]; then
            eval "$("$brew_bin" shellenv)"
        fi
        path_prepend "$HOMEBREW_PREFIX/sbin"
        path_prepend "$HOMEBREW_PREFIX/bin"
        break
    fi
done
unset brew_bin

case ":${MANPATH:-}:" in
    *:"$HOME/.local/share/man":*) ;;
    *) export MANPATH="$HOME/.local/share/man:${MANPATH:-}:" ;;
esac
